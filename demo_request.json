{
  "steps": [
    {
      "id": "FetchLog",
      "type": "shell",
      "config": {
        "command": "echo Out of memory error in worker pool 3"
      }
    },
    {
      "id": "AiTriage",
      "type": "ai",
      "config": {
        "prompt": "Analyze this incident log: ${{ steps.FetchLog.stdout }}. Return JSON with 'severity', 'root_cause', and 'recommended_action'.",
        "response_format": "json"
      },
      "depends_on": ["FetchLog"]
    },
    {
      "id": "NotifySlack",
      "type": "rest",
      "config": {
        "url": "https://httpbin.org/post",
        "method": "POST",
        "body": {
          "alert_level": "${{ steps.AiTriage.response.severity }}",
          "action": "${{ steps.AiTriage.response.recommended_action }}"
        }
      },
      "depends_on": ["AiTriage"]
    },
    {
      "id": "IndepBranch",
      "type": "shell",
      "config": {
        "command": "echo Background health check OK"
      }
    }
  ]
}